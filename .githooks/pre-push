#!/usr/bin/env bash
# Hyphae repository pre-push hook (activate via `git config core.hooksPath .githooks`
# or `just install-hooks`).
#
# Runs fast, zero-flakiness local gates before every push:
#   1. Rust formatting (`cargo fmt --all -- --check`)
#   2. JS/TS linting (`oxlint --config .oxlintrc.json --deny-warnings`)

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "[pre-push] Checking Rust formatting (cargo fmt --all -- --check)..."
if ! command -v cargo >/dev/null 2>&1; then
  echo "[pre-push] ERROR: cargo not found on PATH." >&2
  exit 1
fi
cargo fmt --all -- --check

echo "[pre-push] Linting JS/TS (oxlint --deny-warnings)..."
if [ -x "$repo_root/node_modules/.bin/oxlint" ]; then
  "$repo_root/node_modules/.bin/oxlint" --config .oxlintrc.json --deny-warnings plugins site workers scripts itest
elif command -v oxlint >/dev/null 2>&1; then
  oxlint --config .oxlintrc.json --deny-warnings plugins site workers scripts itest
elif command -v npx >/dev/null 2>&1; then
  npx --yes oxlint@1.95.0 --config .oxlintrc.json --deny-warnings plugins site workers scripts itest
else
  echo "[pre-push] ERROR: neither node_modules/.bin/oxlint, oxlint, nor npx is available. Run 'npm install' first." >&2
  exit 1
fi

echo "[pre-push] All checks passed."
